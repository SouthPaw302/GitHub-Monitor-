MONITOR_OWNER=SouthPaw302
# Optional: comma-separated exact repositories. Omit to sample recently pushed owner repos.
MONITOR_REPOS=SouthPaw302/AIVideoEdit,SouthPaw302/GitHub-Monitor-
# Server-side only. Recommended for higher rate limits and runner telemetry.
MONITOR_GITHUB_TOKEN=
# Mutating workflow controls fail closed unless explicitly enabled.
MONITOR_MUTATIONS_ENABLED=false

# GitHub OAuth operator identity (Auth.js)
# Callback: https://githubmonitor-seven.vercel.app/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_SECRET=
MONITOR_AUTHORIZED_USERS=SouthPaw302
